#!/usr/bin/env bash

set -eou pipefail

BLING_CLI_DIRECTORY="/usr/share/ublue-os/bling"
USER_BLING_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/bling"

BLING_SCRIPT_SOURCE=""
TARGET_CONFIG_FILE=""

get_current_shell() {
  local parent_cmd=""
  if [ -r "/proc/$PPID/comm" ]; then
    parent_cmd="$(cat "/proc/$PPID/comm")"
  elif command -v ps >/dev/null 2>&1; then
    parent_cmd="$(ps -p $PPID -o comm= 2>/dev/null)"
  fi

  parent_cmd="$(basename "${parent_cmd#-}")"

  case "${parent_cmd}" in
  bash | zsh | fish) echo "${parent_cmd}" ;;
  *) basename "${SHELL:-bash}" ;;
  esac
}
shell="$(get_current_shell)"
case "${shell}" in
"fish")
  BLING_SCRIPT_SOURCE="bling.fish"
  TARGET_CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish"
  ;;
"zsh")
  BLING_SCRIPT_SOURCE="bling.sh"
  TARGET_CONFIG_FILE="${ZDOTDIR:-$HOME}/.zshrc"
  ;;
"bash")
  BLING_SCRIPT_SOURCE="bling.sh"
  TARGET_CONFIG_FILE="${HOME}/.bashrc"
  ;;
*)
  echo 'Unknown shell. You are on your own.'
  exit 1
  ;;
esac

USER_BLING_FILE="${USER_BLING_DIR}/${BLING_SCRIPT_SOURCE}"

function is-bling-installed() {
  [ -f "$TARGET_CONFIG_FILE" ] || return 1

  if grep -q "### ${BLING_SCRIPT_SOURCE} source start" "$TARGET_CONFIG_FILE" ||
    grep -q "${USER_BLING_FILE}" "$TARGET_CONFIG_FILE"; then
    return 0
  fi
  return 1
}

[ -f "${BLING_ENV_SCRIPT:-/usr/share/ublue-os/bling/env.sh}" ] && . "${BLING_ENV_SCRIPT:-/usr/share/ublue-os/bling/env.sh}"

BLING_MESSAGE_ENABLE="${BLING_MESSAGE_ENABLE:-Enable bling for ${shell}?}"
BLING_MESSAGE_DISABLE="${BLING_MESSAGE_DISABLE:-Disable bling for ${shell}?}"

if is-bling-installed "${shell}"; then
  gum confirm "${BLING_MESSAGE_DISABLE}" || exit 0

  if [ -f "${TARGET_CONFIG_FILE}" ]; then
    sed -i "/### ${BLING_SCRIPT_SOURCE} source start/,/### ${BLING_SCRIPT_SOURCE} source end/d" "${TARGET_CONFIG_FILE}"
  fi

  if [ -f "${USER_BLING_FILE}" ]; then
    rm -f "${USER_BLING_FILE}"
    echo "Removed local copy: ${USER_BLING_FILE}"
  fi

  echo "Bling removed. Reopen your terminal so that the configurations may be removed."
else
  gum confirm "${BLING_MESSAGE_ENABLE}" --affirmative="Bling me up!" --negative "No, I'm boring" || exit 0

  mkdir -p "${USER_BLING_DIR}"
  mkdir -p "$(dirname "${TARGET_CONFIG_FILE}")"
  touch "${TARGET_CONFIG_FILE}"

  SOURCE_FILE="${BLING_CLI_DIRECTORY}/${BLING_SCRIPT_SOURCE}"
  if [ ! -f "${SOURCE_FILE}" ]; then
    echo "Error: Source file ${SOURCE_FILE} does not exist!"
    exit 1
  fi

  cp -i "${SOURCE_FILE}" "${USER_BLING_FILE}"
  echo "Copied ${BLING_SCRIPT_SOURCE} to ${USER_BLING_FILE}"

  echo "Adding source statement to $(basename "${TARGET_CONFIG_FILE}")"
  cat <<EOF >>"${TARGET_CONFIG_FILE}"

### ${BLING_SCRIPT_SOURCE} source start
test -f "${USER_BLING_FILE}" && source "${USER_BLING_FILE}"
### ${BLING_SCRIPT_SOURCE} source end
EOF

  if [ -f "${BLING_CLI_DIRECTORY}/starship.toml" ]; then
    echo "Adding starship.toml to .config"
    cp -i "${BLING_CLI_DIRECTORY}/starship.toml" "${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
  fi

  echo "Installation complete. Reopen your terminal so that the configurations may be applied."
fi
